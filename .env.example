# Copier en .env (jamais commité) et remplir.

# Aiven (injectées automatiquement sur Aiven Runtime)
DATABASE_URL=postgresql://user:password@host:port/defaultdb?sslmode=require
CLICKHOUSE_URL=https://user:password@host:port
VALKEY_URL=rediss://default:password@host:port

# LLM
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5-5
# Agents : auto = Claude si ANTHROPIC_API_KEY est défini, sinon cerveau de démo ; live ; scripted
AGENT_MODE=auto

# WHOOP (developer-dashboard.whoop.com)
WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=
WHOOP_REDIRECT_URI=http://localhost:8000/oauth/whoop/callback

# Google Calendar (OAuth, mode test)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/oauth/google/callback

# App
USER_ID=ichane
PORT=8000
